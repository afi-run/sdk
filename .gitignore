# Node / TypeScript
node_modules/
dist/
build/
*.js.map
*.tsbuildinfo

# Env / secrets
.env
.env.*

# IDEs / editors
.idea
.vscode/
*.swp
*.swo
*~

# Local tool state
.claude

# Coverage artifacts (generated by `npm run test:coverage` / `make test-coverage`)
coverage/
*.lcov
*.cov
nodejs/coverage/
go/coverage.out
go/coverage.html

# Go build artifacts
*.exe
*.test
*.out
bin/
tmp/
vendor/

# Go workspace (local-only — should not be versioned)
go.work
go.work.sum

# Go examples build into examples/go/bin/ (via `make build`) — covered by the
# bin/ rule above. Build artifacts never need tracking.

# OS junk
.DS_Store
Thumbs.db

# Logs
*.log
