#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
NODE_DIR="$REPO_ROOT/nodejs"
GO_DIR="$REPO_ROOT/go"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

fail() { echo -e "${RED}✗ $1${NC}" >&2; exit 1; }
pass() { echo -e "${GREEN}✓ $1${NC}"; }
warn() { echo -e "${YELLOW}⚠  $1${NC}"; }
section() { echo -e "\n${BOLD}━━━ $1 ━━━${NC}"; }

# ──────────────── Node.js ────────────────
section "Node.js"

cd "$NODE_DIR"

echo "→ vulnerability audit..."
npm audit --audit-level=high 2>&1 || fail "npm audit: high/critical vulnerabilities found — fix before committing"
pass "no high/critical vulnerabilities"

echo "→ tests + coverage (100% required on testable files)..."
npx vitest run --coverage 2>&1 || fail "Node.js tests failed or coverage below 100%"
pass "all tests passed, coverage 100%"

# ──────────────── Go ────────────────
section "Go"

cd "$GO_DIR"

echo "→ go vet..."
go vet ./... 2>&1 || fail "go vet: issues found"
pass "go vet clean"

if command -v govulncheck &>/dev/null; then
  echo "→ govulncheck..."
  govulncheck ./... 2>&1 || fail "govulncheck: vulnerabilities found — fix before committing"
  pass "no known Go vulnerabilities"
else
  warn "govulncheck not installed — skipping vulnerability scan"
  warn "install with: go install golang.org/x/vuln/cmd/govulncheck@latest"
fi

echo "→ tests + coverage (100% required on testable files)..."
COVER_RAW=$(mktemp /tmp/afi-cover-XXXXXX.out)
COVER_FILTERED=$(mktemp /tmp/afi-cover-filtered-XXXXXX.out)
trap 'rm -f "$COVER_RAW" "$COVER_FILTERED"' EXIT

go test -coverprofile="$COVER_RAW" ./... 2>&1 || fail "Go tests failed"

# Exclude blockchain files that require a live RPC node
head -1 "$COVER_RAW" > "$COVER_FILTERED"
grep -v -E "/(client|swap|token)\.go:" "$COVER_RAW" >> "$COVER_FILTERED"

COVERAGE=$(go tool cover -func="$COVER_FILTERED" | grep "^total:" | awk '{gsub(/%/,"",$3); print $3}')
[ -n "$COVERAGE" ] || fail "could not calculate Go coverage"

if awk "BEGIN { exit !($COVERAGE < 100) }"; then
  echo ""
  go tool cover -func="$COVER_FILTERED" | grep -v "100.0%"
  fail "Go coverage is ${COVERAGE}% — need 100% on testable files (client.go, swap.go, token.go excluded)"
fi
pass "all tests passed, coverage ${COVERAGE}%"

echo -e "\n${GREEN}${BOLD}All checks passed — committing.${NC}\n"
